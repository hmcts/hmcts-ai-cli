{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!**/*.js", "!**/coverage", "!**/dist", "!**/node_modules", "!**/.yarn", "!**/.claude/worktrees"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 160
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useBlockStatements": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "node:child_process": "Spawning processes belongs to the Runner seam: import it from src/system/runner.ts instead.",
              "node:fs": "File access belongs to the Fs seam: import it from src/system/fs.ts instead.",
              "node:fs/promises": "File access belongs to the Fs seam: import it from src/system/fs.ts instead.",
              "node:net": "Sockets belong to the Net seam: import it from src/system/net.ts instead."
            }
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "none"
    }
  },
  "overrides": [
    {
      "includes": ["src/system/runner.ts", "src/system/fs.ts", "src/system/net.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
