{
  "name": "@hmcts-cft/hai-cli",
  "version": "0.0.15",
  "description": "hai — an HMCTS wrapper around the Claude Code CLI that resolves which model route and credentials an engineer should use, then runs claude.",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "registry": "https://pkgs.dev.azure.com/hmcts/Artifacts/_packaging/hmcts-lib/npm/registry/"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@4.18.1",
  "bin": {
    "hai": "dist/bin/hai.js",
    "hair": "dist/bin/hair.js",
    "sbx-hai": "dist/bin/sbx-hai.js"
  },
  "files": [
    "dist",
    "runtime"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage *.tsbuildinfo",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/node": "24.12.3",
    "@vitest/coverage-v8": "4.1.12",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
